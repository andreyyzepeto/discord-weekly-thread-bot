{
  "name": "discord-weekly-thread-bot",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "doctor": "tsx src/doctor.ts",
    "create-now": "tsx src/manage-instance.ts create-now",
    "doctor-instance": "tsx src/manage-instance.ts doctor",
    "start-instance": "tsx src/manage-instance.ts start"
  },
  "dependencies": {
    "cron": "^4.3.3",
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7",
    "luxon": "^3.6.1"
  },
  "overrides": {
    "lodash": "4.18.1",
    "undici": "6.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/luxon": "^3.6.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
